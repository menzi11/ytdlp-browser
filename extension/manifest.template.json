{
  "manifest_version": 3,
  "name": "yt-dlp 下载器",
  "version": "0.1.0",
  "description": "把当前页面交给本地 yt-dlp 下载：自动带浏览器登录态 cookie，支持画质选择、仅音频、嵌入字幕。",
  "key": "__KEY__",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "yt-dlp 下载"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
